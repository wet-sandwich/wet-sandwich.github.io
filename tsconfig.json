{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": [
			"$app/types",
			"node"
		],
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"moduleResolution": "bundler",
		"paths": {
			"#lib/utils": ["./src/lib/utils/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
